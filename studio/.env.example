# Copy to studio/.env and fill in. These are NOT secrets (project ID and dataset are public),
# but studio/.env is still git-ignored so each machine keeps its own settings.

# sanity.io/manage → your project → the "Project ID" shown at the top (8 characters, e.g. abcd1234)
SANITY_STUDIO_PROJECT_ID=your-project-id

# Dataset name (Sanity creates "production" by default)
SANITY_STUDIO_DATASET=production

# Optional: date-based API version for the Vision query tool
SANITY_STUDIO_API_VERSION=2025-02-19

# Optional: hosted Studio address → https://<hostname>.sanity.studio
SANITY_STUDIO_HOSTNAME=abhinav-kunwar-portfolio
