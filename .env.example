# Copy this file to ".env" and fill in the values. Never commit .env.
# On Render, add the same names under the service's Environment tab instead.

# ── Sanity CMS (portfolio projects) ────────────────────────────────────────────
# Leave SANITY_PROJECT_ID empty to keep using the projects in public/js/data.js.
# Find it at sanity.io/manage → your project → "Project ID" (8 characters, e.g. abcd1234).
# These values are public identifiers, not secrets. No Sanity token is needed or used.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Date-based API version. Keep this fixed; change it only on purpose.
SANITY_API_VERSION=2025-02-19
# How long the server keeps a copy of the project list before asking Sanity again (seconds).
SANITY_CACHE_SECONDS=60

# ── Contact form ───────────────────────────────────────────────────────────────
# The form sends through Web3Forms (key in public/js/data.js → CONFIG.web3formsKey).
# The settings below are only used if web3formsKey is empty AND the host allows SMTP
# (Render's free plan does not).

# Gmail account that sends the inquiry emails
SMTP_USER=your-gmail-address@gmail.com
# Google App Password (16 characters) — NOT your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords (2-Step Verification must be on).
SMTP_PASS=

# Where inquiries are delivered
MAIL_TO=kunwarabhi7320@gmail.com

# Optional — defaults shown. Change only if you use a provider other than Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# MAIL_FROM="Portfolio Inquiry" <your-gmail-address@gmail.com>

# ── Server ─────────────────────────────────────────────────────────────────────
# Set to 1 when hosted behind a proxy (Render, Railway, Fly.io…)
# TRUST_PROXY=1
# PORT=3000
